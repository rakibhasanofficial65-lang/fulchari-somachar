{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },

  "routes": [

    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },

    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1"
    },

    {
      "src": "/api/upload",
      "dest": "/api/upload.js"
    },

    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }

  ]
}
