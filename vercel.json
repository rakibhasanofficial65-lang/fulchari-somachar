{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/news/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/category/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/search/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/epaper",
      "dest": "/api/index.php"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/index.php"
    },
    {
      "src": "/admin/(.*\\.php)",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*\\.php)",
      "dest": "/api/index.php"
    }
  ]
}